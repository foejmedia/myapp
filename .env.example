# Google Maps Embed API key for the Mosques map (free, no usage charge).
# Create it in Google Cloud with only "Maps Embed API" enabled, restricted to your site.
# Without it the map falls back to Google's keyless embed link.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Server-only key with the "Geocoding API" enabled. Turns "Use my location" into the name of the
# user's area, because Google's free map only searches by place name. ~10,000 free lookups/month.
# Without it, users type their area instead.
GOOGLE_MAPS_API_KEY=
